# ==============================================================
# AWS FraudShield - Environment Configuration Template
# ==============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR AWS CREDENTIALS TO SOURCE CONTROL.
# ==============================================================

# Application Runtime Mode: local | aws
ENVIRONMENT=local

# Local Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Risk Threshold Bands (Configurable)
# LOW: score < RISK_THRESHOLD_LOW (Default: 0.30)
# MEDIUM: RISK_THRESHOLD_LOW <= score < RISK_THRESHOLD_HIGH (Default: 0.30 - 0.70)
# HIGH: score >= RISK_THRESHOLD_HIGH (Default: 0.70)
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70

# Storage Backend: memory | sqlite | dynamodb
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=backend/fraudshield.db

# Model Inference Engine: local | sagemaker
INFERENCE_ENGINE=local
LOCAL_MODEL_PATH=models/fraud_detector_pipeline.joblib
METRICS_PATH=models/metrics.json

# AWS Configuration (Required only when ENVIRONMENT=aws)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-here
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
DYNAMODB_TRANSACTIONS_TABLE=FraudShieldTransactions
DYNAMODB_USERS_TABLE=FraudShieldUserProfiles
SAGEMAKER_ENDPOINT_NAME=fraudshield-xgb-endpoint
S3_BUCKET_NAME=fraudshield-ml-artifacts-bucket
CLOUDWATCH_LOG_GROUP=/aws/lambda/fraudshield-processor
